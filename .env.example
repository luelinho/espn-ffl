# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Required only if the league is private. Get these from a browser where
# you're logged into ESPN Fantasy: open dev tools -> Application (Chrome/Edge)
# or Storage (Firefox) -> Cookies -> fantasy.espn.com, then copy the values
# of the "espn_s2" and "SWID" cookies (SWID includes the curly braces).
ESPN_S2=
ESPN_SWID=

LEAGUE_ID=
SEASON_YEAR=
